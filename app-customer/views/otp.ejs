<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GenieACS INET Custom | Verifikasi OTP</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">

  <style>
    body {
      background: radial-gradient(circle at top, #020617, #020617);
      font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
      color: #e5e7eb;
    }

    .otp-container {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .otp-card {
      background: rgba(15, 23, 42, 0.95);
      backdrop-filter: blur(10px);
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.05);
      box-shadow: 0 20px 60px rgba(0,0,0,0.8);
      max-width: 400px;
      width: 100%;
    }

    .otp-header {
      background: linear-gradient(90deg, #2563eb, #1d4ed8);
      color: white;
      padding: 30px 20px;
      text-align: center;
      border-radius: 20px 20px 0 0;
    }

    .logo-container {
      width: 80px;
      height: 80px;
      background: rgba(255,255,255,0.1);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 15px;
      box-shadow: 0 0 15px rgba(59,130,246,0.4);
    }

    .logo-container img {
      width: 50px;
      height: 50px;
      object-fit: contain;
    }

    .form-container {
      padding: 30px 25px;
    }

    .form-control {
      background: #020617;
      border: 1px solid #1e293b;
      border-radius: 12px;
      padding: 15px;
      color: #e5e7eb;
      text-align: center;
      letter-spacing: 3px;
      font-weight: 600;
    }

    .form-control:focus {
      border-color: #3b82f6;
      box-shadow: 0 0 0 1px #3b82f6;
      background: #020617;
      color: #fff;
    }

    label {
      color: #94a3b8 !important;
    }

    .btn-verify {
      background: linear-gradient(90deg, #2563eb, #1d4ed8);
      border: none;
      border-radius: 12px;
      padding: 14px;
      font-weight: 600;
    }

    .btn-verify:hover {
      transform: translateY(-1px);
      box-shadow: 0 10px 25px rgba(37,99,235,0.4);
    }

    .alert-danger {
      background: rgba(220,38,38,0.1);
      color: #f87171;
      border: 1px solid rgba(220,38,38,0.2);
    }

    .otp-info {
      background: rgba(37,99,235,0.1);
      border-radius: 12px;
      padding: 15px;
      margin-bottom: 20px;
      color: #93c5fd;
      border: 1px solid rgba(37,99,235,0.2);
    }

    .footer-text {
      color: #64748b;
      font-size: 12px;
      margin-top: 20px;
      text-align: center;
    }

    @media (max-width: 576px) {
      .otp-card {
        border-radius: 15px;
      }
    }
  </style>
</head>

<body>

<div class="otp-container">
  <div class="otp-card">

    <div class="otp-header">
      <div class="logo-container">
        <img src="/img/logo.png" alt="Logo">
      </div>
      <h5 class="fw-bold mb-1">Verifikasi OTP</h5>
      <p class="mb-0 opacity-75">Masukkan kode OTP dari WhatsApp</p>
    </div>

    <div class="form-container">

      <% if (error) { %>
        <div class="alert alert-danger">
          <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
        </div>
      <% } %>

      <div class="otp-info">
        <i class="bi bi-info-circle me-2"></i>
        OTP dikirim ke <strong><%= phone %></strong>
      </div>

      <form method="POST" action="/customer/otp">
        <input type="hidden" name="phone" value="<%= phone %>">

        <div class="form-floating mb-3">
          <input type="text" class="form-control" id="otp" name="otp"
            placeholder="Kode OTP"
            required
            pattern="[0-9]{<%= otp_length %>}"
            maxlength="<%= otp_length %>"
            autofocus>
          <label for="otp">
            <i class="bi bi-shield-lock me-2"></i>Kode OTP (<%= otp_length %> digit)
          </label>
        </div>

        <button type="submit" class="btn btn-verify w-100">
          <i class="bi bi-check-circle me-2"></i>Verifikasi
        </button>
      </form>

      <div class="footer-text">
        &copy; <%= new Date().getFullYear() %><br>
       <b>GENIEACS INET CUSTOM</b> — Network Operation Center<br>
		<small>by Reza Habibie</small>
      </div>

    </div>

  </div>
</div>

</body>
</html>