<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GenieACS INET Custom | Portal Pelanggan</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">

  <style>
    body {
      background: #020617;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
      color: #e5e7eb;
      min-height: 100vh;
    }

    /* NAVBAR */
    .navbar {
      background: rgba(2,6,23,0.9) !important;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .navbar-brand {
      color: #e5e7eb !important;
      font-weight: 600;
    }

    .navbar-brand img {
      height: 40px;
      border-radius: 8px;
    }

    /* CARD */
    .card {
      background: #0f172a !important;
      border-radius: 16px;
      border: 1px solid rgba(255,255,255,0.05);
      box-shadow: 0 10px 40px rgba(0,0,0,0.6);
    }

    .card-header {
      background: linear-gradient(90deg, #2563eb, #1d4ed8);
      color: white;
    }

    /* STAT */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 15px;
    }

    .stat-card {
      background: #020617;
      border-radius: 12px;
      padding: 15px;
      border: 1px solid rgba(255,255,255,0.05);
      text-align: center;
    }

    .stat-icon {
      width: 40px;
      height: 40px;
      margin: auto;
      margin-bottom: 10px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg,#3b82f6,#2563eb);
      box-shadow: 0 0 10px rgba(59,130,246,0.5);
      color: white;
    }

    .stat-label {
      color: #94a3b8;
      font-size: 12px;
    }

    .stat-value {
      color: #e5e7eb;
      font-weight: bold;
    }

    /* FORM */
    .form-section {
      background: #0f172a;
      border-radius: 16px;
      padding: 20px;
      margin-top: 20px;
      border: 1px solid rgba(255,255,255,0.05);
    }

    .form-control {
      background: #020617;
      border: 1px solid #1e293b;
      color: #e5e7eb;
    }

    .form-control:focus {
      border-color: #3b82f6;
      box-shadow: 0 0 0 1px #3b82f6;
    }

    /* BUTTON */
    .btn-action {
      background: linear-gradient(90deg,#2563eb,#1d4ed8);
      color: white;
      border-radius: 8px;
    }

    .btn-password {
      background: linear-gradient(90deg,#16a34a,#22c55e);
    }

    .btn-danger {
      background: linear-gradient(90deg,#dc2626,#ef4444);
    }

    /* TABLE */
    .table-container {
      background: #0f172a;
      border-radius: 16px;
      padding: 20px;
      margin-top: 20px;
    }

    .table {
      color: #e5e7eb;
    }

    .table th {
      background: #020617;
      color: #94a3b8;
    }

    /* ALERT */
    .alert-info {
      background: rgba(37,99,235,0.1);
      color: #93c5fd;
    }

    /* FOOTER */
    .footer {
      text-align: center;
      color: #64748b;
      margin-top: 30px;
    }

    /* STATUS */
    .status-badge {
      background: rgba(34,197,94,0.15);
      color: #22c55e;
    }

  </style>
</head>

<body>

<nav class="navbar">
  <div class="container d-flex justify-content-between">
    <span class="navbar-brand">
      <img src="/img/logo.png"> Portal Pelanggan
    </span>
  </div>
</nav>

<div class="container mt-4">

  <div class="card">
    <div class="card-header">
      Halo, <b><%= customer.phone %></b>
    </div>

    <div class="card-body">
      <div class="stats-grid">

        <div class="stat-card">
          <div class="stat-icon"><i class="bi bi-wifi"></i></div>
          <div class="stat-label">SSID</div>
          <div class="stat-value"><%= customer.ssid %></div>
        </div>

        <div class="stat-card">
          <div class="stat-icon"><i class="bi bi-cpu"></i></div>
          <div class="stat-label">Version</div>
          <div class="stat-value"><%= customer.softwareVersion %></div>
        </div>

        <div class="stat-card">
          <div class="stat-icon"><i class="bi bi-globe"></i></div>
          <div class="stat-label">IP</div>
          <div class="stat-value"><%= customer.pppoeIP %></div>
        </div>

      </div>
    </div>
  </div>

  <div class="form-section">
    <form method="POST" action="/customer/change-ssid">
      <input class="form-control mb-2" name="ssid" placeholder="SSID baru">
      <button class="btn btn-action w-100">Ganti SSID</button>
    </form>
  </div>

  <div class="form-section">
    <form method="POST" action="/customer/change-password">
      <input class="form-control mb-2" name="password" placeholder="Password baru">
      <button class="btn btn-password w-100">Ganti Password</button>
    </form>
  </div>

</div>

<footer class="footer">
  © <%= new Date().getFullYear() %> 
  <b>GENIEACS INET CUSTOM</b> — Network Operation Center<br>
  <small>by Reza Habibie</small>
</footer>

</body>
</html>